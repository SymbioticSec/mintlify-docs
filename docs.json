{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Symbiotic Security",
  "colors": {
    "primary": "#C45D97",
    "light": "#C45D97",
    "dark": "#C45D97"
  },
  "fonts": {
    "family": "Inter"
  },
  "favicon": "images/favicon_symbiotic.png",
  "icons": {
    "library": "lucide"
  },
  "interaction": {
    "drilldown": true
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://symbioticsec.ai",
          "icon": "globe"
        },
        {
          "anchor": "Changelog",
          "href": "https://docs.symbioticsec.ai/changelog",
          "icon": "logs"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Code",
        "icon": "square-terminal",
        "pages": [
          "code/get_started",
          "code/migrating",
          "code/using",
          "code/use_cases",
          {
            "group": "Basics",
            "pages": [
              "code/basics/IDE_extension",
              "code/basics/TUI",
              "code/basics/models_and_providers",
              "code/basics/agents",
              "code/basics/common_commands",
              "code/basics/rules",
              "code/basics/configuration_file",
              "code/basics/troubleshooting"
            ]
          },
          {
            "group": "Customize",
            "pages": [
              "code/customize/skills",
              "code/customize/plugins",
              "code/customize/custom_commands",
              "code/customize/custom_agents",
              "code/customize/custom_tools"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "code/security/security_modes",
              "code/security/security_tools",
              "code/security/containers",
              "code/security/tool_permissions"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "code/configuration/mcp",
              "code/configuration/lsp",
              "code/configuration/acp",
              "code/configuration/keybinds"
            ]
          }
        ]
      },
      {
        "tab": "Flow",
        "icon": "search-code",
        "groups": [
              {
                "group": "Getting started",
                "pages": [
                  "flow/devs/intro/get_started",
                  "flow/devs/intro/quickstart"
                ]
              },
              {
                "group": "Tools",
                "pages": [
                  {
                    "group": "IDE extension",
                    "pages": [
                      "flow/devs/discover_extension/detection",
                      "flow/devs/discover_extension/treeview",
                      "flow/devs/discover_extension/details",
                      "flow/devs/discover_extension/deep_remediation",
                      "flow/devs/discover_extension/hover",
                      "flow/devs/discover_extension/status"
                    ]
                  },
                  "flow/devs/discover_extension/MCP",
                  "flow/devs/discover_extension/CLI"
                ]
              },
              {
                "group": "Configuration",
                "pages": [
                  "flow/devs/actions/configure_detection",
                  "flow/devs/actions/ignore",
                  "flow/devs/actions/false_positive",
                  "flow/admins/setup_CI_integration"
                ]
              },
              {
                "group": "Support",
                "pages": [
                  "flow/devs/support/share_logs",
                  "flow/devs/support/support_bundle",
                  "flow/devs/support/common_problems",
                  "flow/devs/support/commands"
                ]
              }
            ]
      },
      {
        "tab": "Admin",
        "icon": "building",
        "pages": [
          {
            "group": "Access & identity",
            "pages": [
              "flow/admins/user_management"
            ]
          },
          {
            "group": "AI governance",
            "pages": [
              "flow/admins/guardrails",
              "flow/admins/agent_security"
            ]
          },
          {
            "group": "Visibility",
            "pages": [
              "flow/admins/monitored_repositories",
              "flow/admins/ai_inventory"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "flow/admins/webhooks",
              "flow/admins/github_integration"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "images/logo/logo horizontal_black.svg",
    "dark": "images/logo/logo horizontal_white.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@symbioticsec.ai"
      },
      {
        "label": "Status",
        "href": "https://status.symbioticsec.ai/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Symbiotic app",
      "href": "https://app.symbioticsec.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/symbiotic-security",
      "github": "https://github.com/symbioticsec"
    }
  },
  "redirects": [
    { "source": "/code/tools/custom_commands", "destination": "/code/customize/custom_commands" },
    { "source": "/code/tools/custom_agents", "destination": "/code/customize/custom_agents" },
    { "source": "/code/tools/custom_tools", "destination": "/code/customize/custom_tools" },
    { "source": "/code/configuration/skills", "destination": "/code/customize/skills" },
    { "source": "/code/configuration/plugins", "destination": "/code/customize/plugins" },
    { "source": "/code/configuration/security_modes", "destination": "/code/security/security_modes" },
    { "source": "/code/tools/security_tools", "destination": "/code/security/security_tools" },
    { "source": "/code/configuration/tool_permissions", "destination": "/code/security/tool_permissions" },
    { "source": "/code/tools/containers", "destination": "/code/security/containers" }
  ]
}
